# Cubic Castles relay + Discord bot — systemd environment file.
#
# Copy this to  /etc/cubic-castles/cubic-castles.env  (the installer does that for
# you if it isn't there yet), fill in the two secrets, then:
#     sudo systemctl restart cc-relay cc-discord-bot
#
# This file is read by systemd (as root) and holds SECRETS. Keep it out of the
# repo and locked down:  chmod 600  and owned by root. Never commit the real one.

# --- REQUIRED --------------------------------------------------------------

# The relay's admin password. The Discord bot authenticates to the relay with it.
# Both services share this ONE value, so it must match. Generate a fresh one with:
#     python3 -c "import secrets; print(secrets.token_urlsafe(32))"
RELAY_ADMIN_TOKEN=CHANGE_ME_long_random_secret

# The Discord bot token (Discord Developer Portal -> your app -> Bot -> Token).
# Used only by cc-discord-bot; the relay ignores it.
DISCORD_TOKEN=CHANGE_ME_discord_bot_token

# --- OPTIONAL (sensible defaults; uncomment to override) -------------------

# Where the Discord bot reaches the relay. They run on the SAME box, so this is
# localhost — do NOT point it back out through your public endpoint.
#RELAY_URL=http://127.0.0.1:8788

# Relay bind address / port (must line up with RELAY_URL and whatever your public
# endpoint forwards to).
#RELAY_HOST=127.0.0.1
#RELAY_PORT=8788

# Where the relay persists its bindings (Discord user <-> bot links). Defaults to
# relay_state.json beside cc_relay.py; set an absolute path to keep it elsewhere.
#RELAY_STATE_FILE=/var/lib/cubic-castles/relay_state.json

# Single-server (dev) mode: pin slash commands to ONE guild for instant sync.
# LEAVE EMPTY for the normal "invite the bot to any server" multi-server model
# (global command sync, can take up to ~1h to first appear).
#DISCORD_GUILD_ID=
