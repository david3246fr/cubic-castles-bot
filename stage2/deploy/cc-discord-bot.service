[Unit]
Description=Cubic Castles Discord bot (remote control front-end)
Documentation=https://github.com/david3246fr/cubic-castles-bot
After=network-online.target cc-relay.service
Wants=network-online.target
# Start the relay first if it's enabled, but don't hard-fail if it's momentarily
# down — the bot just retries its localhost calls.
Wants=cc-relay.service

[Service]
Type=simple
User=@USER@
WorkingDirectory=@STAGE2@
EnvironmentFile=@ENVFILE@
ExecStart=@PYTHON@ -u @STAGE2@/cc_discord_bot.py
Restart=on-failure
RestartSec=5

# --- light hardening ---
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
